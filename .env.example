# Copy this file to .env and fill in what you want to use.

# Discord digest
# Server Settings > Integrations > Webhooks > New Webhook > Copy Webhook URL
DISCORD_WEBHOOK_URL=

# Using a forum channel? Create the webhook inside that forum channel and set
# this to true. Each digest then becomes its own post titled like
# "October 26 Morning Digest", with the stories in the post body.
DISCORD_FORUM=false
# Optional: tag IDs to apply to each post (comma-separated). In Discord, turn on
# Developer Mode, then right-click a forum tag and choose Copy Tag ID.
DISCORD_TAG_IDS=

# Optional: Discord user IDs to @mention on every digest (comma-separated) so you get a notification
DISCORD_PING_USER_IDS=

# Optional: severity alerts. A second webhook in a text channel (not the forum),
# plus the ID of the role to @mention. Leave blank to skip alerts.
DISCORD_NOTIFY_WEBHOOK_URL=
DISCORD_NOTIFY_ROLE_ID=
DISCORD_GUILD_ID=
# Set to true to also get a "no news" alert on scheduled runs.
# (Manual runs always send one.)
DISCORD_NOTIFY_ON_EMPTY=false

# Time zone for the time of day in digest titles, for example America/Denver.
# Blank uses this computer's clock.
TIMEZONE=
